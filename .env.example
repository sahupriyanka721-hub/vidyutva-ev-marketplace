# Vidyutva Electric Vehicle Marketplace — Customer Panel Configuration
# Note: Never commit real API secrets or database credentials to version control.

# Application Environment
NODE_ENV=development
PORT=3000
VITE_APP_URL=http://localhost:3000

# PostgreSQL Database (Prisma ORM)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vidyutva_ev_db?schema=public"

# Payment Gateway (Razorpay India Standard)
# In development, the system runs in high-fidelity sandbox simulation mode.
RAZORPAY_KEY_ID="rzp_test_placeholder_key"
RAZORPAY_KEY_SECRET="placeholder_secret"
RAZORPAY_WEBHOOK_SECRET="placeholder_webhook_secret"

# Transactional SMS / Mobile OTP Provider (e.g. MSG91, Twilio, Gupshup)
# In development, use demo OTP: 123456
OTP_PROVIDER_API_KEY="placeholder_otp_key"
OTP_SENDER_ID="VIDYUT"

# Transactional Email Provider (e.g. Resend, SendGrid, Amazon SES)
EMAIL_SERVER_HOST="smtp.placeholder.com"
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER="apikey"
EMAIL_SERVER_PASSWORD="placeholder_email_password"
EMAIL_FROM="Vidyutva Customer Desk <noreply@vidyutva-ev.demo>"

# Object Storage (AWS S3 / Cloudflare R2 / Supabase Storage)
STORAGE_BUCKET_NAME="vidyutva-assets-bucket"
STORAGE_REGION="ap-south-1"
STORAGE_ACCESS_KEY="placeholder_storage_access_key"
STORAGE_SECRET_KEY="placeholder_storage_secret_key"

# Mapping & Geocoding Provider (e.g. Google Maps Platform / MapmyIndia)
MAPS_API_KEY="placeholder_maps_api_key"
